// ===== PR1 (PCTL, Until с вероятностью 1, вложение через filter) =====
// Во всех достижимых состояниях, где датчик отклонил оплату, с вероятностью 1
// створки остаются закрытыми, пока не загорится красный.
"PR1": filter(forall, P>=1 [ g=0 U l=2 ], "rejected")

// ===== PR2 (PCTL, ограниченный Until) =====
// Пассажир с действующей картой проходит в течение 10 тактов, не увидев
// красного сигнала, с вероятностью не менее 0.95 (худший случай по состояниям).
"PR2": filter(forall, P>=0.95 [ l!=2 U<=10 u=3 ], "valid_card_presented")
"PR2_value": filter(min, P=? [ l!=2 U<=10 u=3 ], "valid_card_presented")

// ===== PR3 (LTL внутри P: живость с вероятностью 1) =====
// Почти наверное контроллер бесконечно часто возвращается в исходное состояние.
"PR3": P>=1 [ G F (c=0 & g=0) ]

// ===== PR4 (ОЖИДАЕТСЯ НАРУШЕНИЕ) =====
// Вероятность хотя бы одного безбилетного прохода за 100 тактов не выше 1%.
"PR4": P<=0.01 [ F<=100 "free_ride" ]
"PR4_value": P=? [ F<=100 "free_ride" ]

// ===== Количественный анализ =====
"free_rides_1000":  R{"free_rides"}=? [ C<=1000 ]
"passengers_1000":  R{"passengers"}=? [ C<=1000 ]
"false_rej_1000":   R{"false_rejects"}=? [ C<=1000 ]
"free_ride_share":  S=? [ "free_ride" ]
"gate_open_share":  S=? [ g=1 ]

// ===== Нетривиальность посылок: выполняются бесконечно часто п.н. =====
"V1": P>=1 [ G F "rejected" ]
"V2": P>=1 [ G F "paid" ]
"V3": P>=1 [ G F "valid_card_presented" ]
